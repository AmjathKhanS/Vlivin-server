NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required in production: at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
JWT_EXPIRES_IN=30d
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*
# Pairing codes expire after this many hours
PAIR_CODE_TTL_HOURS=24
# Expo push access token (optional; push is logged only when empty)
EXPO_ACCESS_TOKEN=
# Postgres/Supabase connection string. Required in production; migrations run on boot.
# Leave empty in development to use the in-memory store.
DATABASE_URL=
